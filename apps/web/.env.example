NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Server-only — needed by /api/contact (PL-2b) to insert into contact_leads
# without an authenticated session. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# PL-2b — WhatsApp lead-notification configuration.
# Recipient phone is the team's notification inbox (E.164 digits, e.g.
# "919876543210"). If unset, leads are still CAPTURED but every notification
# fails — manual follow-up via the contact_leads table.
WPBOX_LEAD_NOTIFICATION_PHONE=""
# Template overrides — defaults are the values shown.
WPBOX_LEAD_TEMPLATE_NAME="lead_notification"
WPBOX_LEAD_TEMPLATE_LANGUAGE="en"

# WPBox WhatsApp credentials (server-only; never NEXT_PUBLIC_).
WPBOX_API_TOKEN=""
WPBOX_USER_ID=""
WPBOX_BASE_URL="https://chat.leminai.com"

# Upstash Redis — backs the contact-form rate limit + /track abuse guard.
# If unset, every request is allowed (local dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: absolute origin used as `metadataBase` for SEO/OG/Twitter previews
# on the landing page. Falls back to https://tacexpress.in if unset, blank, or
# malformed. Set this in any environment where the OG image URLs must resolve
# to a non-production hostname (preview deploys, regional staging, etc.).
NEXT_PUBLIC_SITE_URL="https://tacexpress.in"
