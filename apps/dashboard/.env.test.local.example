# Playwright E2E test credentials.
#
# Copy this file to `.env.test.local` and fill in real credentials for the
# seeded SUPER_ADMIN user. Then run:
#
#   E2E_USER_EMAIL=... E2E_USER_PASSWORD=... pnpm --filter dashboard test:e2e
#
# Or use `dotenv-cli`:
#
#   pnpm dlx dotenv-cli -e .env.test.local -- pnpm --filter dashboard test:e2e
#
# Without these, the visual + a11y suites still run on PUBLIC surfaces
# (sign-in, /track, /track/[awb]). Protected routes (/ops-console/*) are
# marked .skip until creds are available.

E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Set to "1" in CI to make any serious/critical axe violation fail the build.
# Locally we keep this off so developers see findings without being blocked.
AXE_FAIL_ON_VIOLATIONS=
