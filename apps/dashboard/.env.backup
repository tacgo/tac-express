# ─────────────────────────────────────────────────────────────────────────────
# TAC Express — Environment Variables (template)
# Copy to apps/web/.env.local and apps/dashboard/.env.local and fill in.
# Never commit real values. .env.local files are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (browser-safe — the anon key is public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Server-only — never expose to the browser. Used by edge functions and server actions.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# App URLs (used for OAuth redirects, webhook signatures)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# Optional: third-party integrations
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SENTRY_DSN=""
ANTHROPIC_API_KEY=""
