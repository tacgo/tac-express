NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# ─── WhatsApp (WPBox / chat.leminai.com) ─────────────────────────────────
# Server-side only. NEVER prefix with NEXT_PUBLIC_ — these must not be
# exposed to the browser bundle.
# Used by: apps/dashboard/app/api/whatsapp/{send-invoice,test}/route.ts

# Kill switch. The routes return 503 immediately when this is anything
# other than the literal string "true" — typo-safe by design. Flip to
# "false" or unset to disable sends without a redeploy when Lemin AI
# changes their template schema, has an outage, or you need to halt
# operationally for any other reason. Defaults to disabled (`false`).
WHATSAPP_ENABLED="true"

WPBOX_API_TOKEN="your-wpbox-api-token"
WPBOX_USER_ID="your-wpbox-user-id"
# Optional — defaults to https://chat.leminai.com if unset.
# WPBOX_BASE_URL="https://chat.leminai.com"

# ─── Invoice PDF signing ─────────────────────────────────────────────────
# HMAC-SHA256 secret used to sign the public /api/public/invoice-pdf URLs
# attached to WhatsApp template messages. WhatsApp's servers fetch these
# URLs without auth — the HMAC signature on the URL itself proves the
# request was authorised by the dashboard.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Server-side only. Minimum 32 bytes / 64 hex chars (this HMAC is the
# only auth boundary on the public /api/public/invoice-pdf route).
# Rotating this invalidates already-sent WhatsApp message URLs
# (acceptable — they're short-lived).
INVOICE_PDF_SIGNING_SECRET="generate-a-32-byte-hex-string"

# ─── Company / bank details rendered on the invoice PDF ──────────────────
# REQUIRED in production. These render directly into a legal tax document,
# so missing values fail the PDF render with a loud error rather than
# silently shipping a placeholder GSTIN / account number to a customer.
#
# COMPANY_ADDRESS uses pipe `|` as a line separator (e.g. "Line 1|Line 2").
COMPANY_LEGAL_NAME="Tapan Associate Cargo"
COMPANY_ADDRESS="Imphal, Manipur, India — 795001"
COMPANY_TEL="+91 385 000 0000"
COMPANY_EMAIL="ops@tapanassociatecargo.in"
COMPANY_WEB="tapanassociatecargo.in"
COMPANY_GSTIN="14AAAAA0000A1Z5"
COMPANY_PAN="AAAAA0000A"
COMPANY_CIN="U63090ML2024PTC012345"

BANK_NAME="State Bank of India · Imphal Main Branch"
BANK_ACCOUNT="0000 0000 0000 0000"
BANK_IFSC="SBIN0000000"
BANK_SWIFT="SBININBBXXX"
BANK_UPI="company-upi-id@bank"

# Optional — explicitly select which approved WPBox template to use for
# invoice sends. Falls back to a name-pattern match (`*invoice*`) and
# then to the single approved template if exactly one exists. Leaving
# this unset is fine when there's only one approved invoice template.
# NEXT_PUBLIC_WHATSAPP_INVOICE_TEMPLATE="tac_express_corridor_invoice"
